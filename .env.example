# Copy this file to ".env" and adjust the values. Never commit ".env".

# Database (used by the postgres container and by the API)
DB_NAME=crud_db
DB_USER=postgres
DB_PASSWORD=change_me

# Ports published on your machine
WEB_PORT=8080
DB_PORT=5433

# Image names: <DOCKERHUB_USER>/catalog-api:<IMAGE_TAG> and <DOCKERHUB_USER>/catalog-web:<IMAGE_TAG>
DOCKERHUB_USER=local
IMAGE_TAG=dev
